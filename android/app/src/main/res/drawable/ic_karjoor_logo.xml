<?xml version="1.0" encoding="utf-8"?>
<!--
  KARJOOR primary logo — 48x48 grid.

  Concept: two independent strokes converge into a single unified mark.
    · The left stroke is the Requester path (Primary #2563EB).
    · The right stroke is the Performer path (Secondary #14B8A6).
  The negative space between them traces a "K". Rounded caps, no clutter,
  no cliché icons. Designed to stay legible at 24dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Shared spine of the K (Navy) — the single unified backbone both paths meet on. -->
    <path
        android:strokeColor="#11244A"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M14,8 L14,40" />

    <!-- Requester arm — upper branch, converges onto the spine. -->
    <path
        android:strokeColor="#2563EB"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M14,21 C22,19 30,15 36,10" />

    <!-- Performer arm — lower branch, converges onto the spine. -->
    <path
        android:strokeColor="#14B8A6"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M14,26 C22,28 30,33 36,38" />
</vector>
