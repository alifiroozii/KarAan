<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Background rounded squircle / shield -->
    <path
        android:pathData="M24,8 L96,8 A16,16 0 0 1 112,24 L112,96 A16,16 0 0 1 96,112 L24,112 A16,16 0 0 1 8,96 L8,24 A16,16 0 0 1 24,8 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="135"
                android:endColor="#0F3460"
                android:startColor="#16213E"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Modern Dynamic 'K' Symbol: Vertical Pillar (Stability/Trust) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,28 L46,28 A4,4 0 0 1 50,32 L50,88 A4,4 0 0 1 46,92 L34,92 A4,4 0 0 1 30,88 L30,32 A4,4 0 0 1 34,28 Z" />

    <!-- Upward Branch (Growth & Opportunity - Emerald Green) -->
    <path
        android:pathData="M52,60 L78,34 A4,4 0 0 1 84,34 L92,42 A4,4 0 0 1 92,48 L68,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="45"
                android:endColor="#10B981"
                android:startColor="#059669"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Downward Branch (Connection & Grounding - Vibrant Cyan/Teal) -->
    <path
        android:pathData="M64,68 L88,92 A4,4 0 0 1 88,98 L80,106 A4,4 0 0 1 74,106 L50,82 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="225"
                android:endColor="#38BDF8"
                android:startColor="#0284C7"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Central Connected Node (Smart AI Hub) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M55,60m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0" />
    <path
        android:fillColor="#10B981"
        android:pathData="M55,60m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0" />
</vector>
